simulations = {
  "positive": [500, 1000, 2000, 4000, 10000],
  "negative": [1000, 2000, 4000, 10000], #500 produces a table of zeroes
  "overlap": [500, 1000, 2000, 4000, 10000]
}

simulations_depths = []
for key, values in simulations.items():
    for value in values:
      simulations_depths.append(f"{key}.{value}")


simulations_depths_size = []
for key, values in simulations.items():
  for rep in range(1, 11):
    simulations_depths_size.append(f"{key}.5000.size_{rep}")


control_processes = {
  "optspace": ["euclidean"],
  "rpca": ["euclidean"],
  "oclr": ["euclidean"],
  "raw": ["bray", "euclidean"]
}

control_processes_dists = []
for key, values in control_processes.items():
    for value in values:
      control_processes_dists.append(f"{key}.{value}")

control_processs_extra = {
  "rare": ["bray", "euclidean"],
  "sub": ["bray", "euclidean"]
}

control_processs_dists_extra = []
for key, values in control_processs_extra.items():
    for value in values:
      control_processs_dists_extra.append(f"{key}.{value}")




cs_processes = {
  "oclr": ["euclidean"],
  "raw": ["bray", "euclidean"],
  "sub": ["bray", "euclidean"],
  "rare": ["bray", "euclidean"]
}

gemelli = {"_2.euclidean", "_3.euclidean", "_4.euclidean", "_5.euclidean",
             "_9.euclidean", "_auto.euclidean"}

cs_processes_dist = []
for key, values in cs_processes.items():
  for value in values:
    cs_processes_dist.append(f"{key}.{value}")

for g in gemelli:
  cs_processes_dist.append(f"gemelli{g}")


knn_approaches = ["cm", "pds", "cmgrid"]


treatment_groups = {"sponges": "health_status",
                    "sleep_apnea": "exposure_type"}


two_depths = {"sponges": [1000, 13755], 
              "sleep_apnea": [1000, 11879],
              "crc": [1000, 10439]}

n_samples = {"sponges": [35, 45, 55, 65, 78], 
             "sleep_apnea": [35, 48, 61, 74, 87],
             "crc": [35, 83, 130, 178, 226]}


samples_depths = []
for key, values in two_depths.items():
    for value in values:
      samples_depths.append(f"{key}/data.{value}")

samples_depths_nsamples_reps = []
for key, values in n_samples.items():
    for value in values:
      for depth in two_depths[key]:
        for rep in range(1,11):
          samples_depths_nsamples_reps.append(f"data/{key}/data.{depth}.{value}_{rep}")

samples_depths_all = []
for key, values in two_depths.items():
  for depth in values:
    samples_depths_all.append(f"data/{key}/data.{depth}.all")

samples_depths_size = []
for key, values in two_depths.items():
  for rep in range(1, 11):
    samples_depths_size.append(f"data/{key}/data.5000.size_{rep}")

rule targets:
  input:
    "data/simulation/simulation.design",
    expand("data/simulation/{simulation_depth}.raw.tsv.gz",
           simulation_depth = simulations_depths + simulations_depths_size),
    expand("data/simulation/{simulation_depth_size}.design",
           simulation_depth_size = simulations_depths_size),
    expand("data/simulation/{simulation_depth}.oclr.tsv.gz",
           simulation_depth = simulations_depths + simulations_depths_size),
    expand("data/simulation/{simulation_depth}.raw.dtest.tsv",
           simulation_depth = simulations_depths),
    expand("data/simulation/{simulation_depth}.{process_dist}.dist.gz",
           simulation_depth = simulations_depths + simulations_depths_size,
           process_dist = control_processes_dists),
    expand("data/simulation/{simulation_depth}.{process_dist}.pcoa.axes",
           simulation_depth = simulations_depths + simulations_depths_size,
           process_dist = control_processes_dists),
    expand("data/simulation/{simulation_depth}.{process_dist}.permanova.tsv",
           simulation_depth = simulations_depths,
           process_dist = control_processes_dists),
    expand("data/simulation/{simulation_depth}.{process_dist}.knn_{approach}.tsv",
           simulation_depth = simulations_depths,
           process_dist = control_processes_dists,
           approach = knn_approaches),
    expand("data/simulation/{control}.5000.size_{iteration}.{process_dist}.permanova.tsv",
            control = simulations.keys(),
            iteration = range(1,11),
            process_dist = control_processes_dists + control_processs_dists_extra),
    #
    expand("data/{dataset}/table.biom",
          dataset = ["sponges", "sleep_apnea"]),
    expand("data/{dataset}/data_treatment.tsv.gz",
          dataset = list(two_depths.keys())),
    expand("data/{dataset}/data.depths.tsv",
          dataset = list(two_depths.keys())),
    expand("data/{dataset}/data.dtest.tsv",
          dataset = list(two_depths.keys())),
    expand("data/{sample_depth}.raw_design.tsv.gz",
          sample_depth = samples_depths),
    expand("{sample_depth_nsample_rep}.{transform}.tsv.gz",
            sample_depth_nsample_rep = samples_depths_all + samples_depths_nsamples_reps + samples_depths_size,
            transform = ["raw", "oclr"]),
    expand("{sample_depth_nsample_rep}.design",
            sample_depth_nsample_rep = samples_depths_all + samples_depths_nsamples_reps + samples_depths_size),
    expand("{sample_depth_nsample_rep}.{process_dist}.dist.gz",
            sample_depth_nsample_rep = samples_depths_all + samples_depths_nsamples_reps + samples_depths_size,
            process_dist = cs_processes_dist),
    expand("{sample_depth_nsample_rep}.{process_dist}.pcoa.axes",
            sample_depth_nsample_rep = samples_depths_all + samples_depths_nsamples_reps + samples_depths_size,
            process_dist = cs_processes_dist),
    expand("{sample_depth_nsample_rep}.{process_dist}.permanova.tsv",
            sample_depth_nsample_rep = samples_depths_all + samples_depths_nsamples_reps,
            process_dist = cs_processes_dist),
    expand("{sample_depth_nsample_rep}.{process_dist}.knn_{approach}.tsv",
            sample_depth_nsample_rep = samples_depths_nsamples_reps,
            process_dist = cs_processes_dist,
            approach = knn_approaches),
    expand("data/{dataset}/data.5000.size_{iteration}.{process_dist}.permanova.tsv",
            dataset = two_depths.keys(),
            iteration = range(1,11),
            process_dist = cs_processes_dist),
#            
    "data/process/simulation.dtest.tsv",
    "data/process/simulation.knn.tsv",
    "data/process/simulation.permanova.tsv",
    "data/process/case_studies.dtest.tsv",
    "data/process/case_studies.knn.tsv",
    "data/process/case_studies.permanova.tsv",
 #
    "figures/overlap10000.pcoa.png",
    "figures/control4000.pcoa.png",
    "figures/knn_control_comparison.png",
    "figures/knn_overlap_comparison.png",
    "figures/cs_seq_depth.png"

##******************************************************************************
##
## Generate raw count tables. The overlap files have some overlap between the
## treatment groups. The negative completely overlap and the positive do not
## overlap at all. Confirm that there is no confounding between treatment group
## and the number of sequences in each sample.
##
## My naming scheme: simulation = control + overlap
##
##******************************************************************************

rule extract_counts_overlap:
  input:
    csv="deicode_benchmarking/simulations/cluster_models/simulation_subsampled_noisy.csv.gz",
    rscript="workflow/scripts/extract_counts_overlap.R"
  output:
    "data/simulation/overlap.{depth}.raw.tsv.gz"
  wildcard_constraints:
    depth="\\d*"
  shell:
    """
    mkdir -p data/simulation/
    {input.rscript} {input.csv} {wildcards.depth}
    """

rule extract_counts_simulation:
  input:
    pyscript="workflow/scripts/extract_counts_control.py",
    deicode="deicode_benchmarking/simulations/scripts/simulations.py"
  output:
    expand("data/simulation/{control}.{depth}.raw.tsv.gz",
           control = ["positive", "negative"], 
           allow_missing = True)
  wildcard_constraints:
    depth="\\d*"
  conda:
    "envs/rpca.yml"
  shell:
    """
    mkdir -p data/simulation/
    PYTHONPATH='.' {input.pyscript} {wildcards.depth}
    """

rule create_design_simulation:
  input:
    rscript="workflow/scripts/create_design_simulation.R"
  output:
    "data/simulation/simulation.design"
  shell:
    """
    {input.rscript} 100 100 {output}
    """

rule partition_by_size_control:
  input:
    counts="data/simulation/{control}.10000.raw.tsv.gz",
    design="data/simulation/simulation.design",
    rscript="workflow/scripts/partition_by_size_control.R"
  output:
    "data/simulation/{control}.5000.size_{seed}.raw.tsv.gz",
    "data/simulation/{control}.5000.size_{seed}.design",
  shell:
    """
    {input.rscript} {input.counts} {input.design} {wildcards.seed}
    """

rule test_depths_simulation:
  input:
    tsv="data/simulation/{control_depth}.raw.tsv.gz",
    design="data/simulation/simulation.design",
    rscript="workflow/scripts/test_depths_simulation.R"
  output:
    "data/simulation/{control_depth}.raw.dtest.tsv"
  shell:
    """
    {input.rscript} {input.tsv} {input.design} {output}
    """


##******************************************************************************
##
## Calculate distances and ordinations. Am using the ipynb code for the RPCA
## calculations because need the OptSpace data, which doesn't appear available
## in gemelli
##
##******************************************************************************

rule calc_dist_axes_rpca_control:
  input:
    tsv="data/simulation/{simulation}.{depth}.raw.tsv.gz",
    pyscript="workflow/scripts/calc_dist_axes_rpca_control.py"
  output:
    "data/simulation/{simulation}.{depth}.optspace.euclidean.dist.gz",
    "data/simulation/{simulation}.{depth}.rpca.euclidean.dist.gz",
    "data/simulation/{simulation}.{depth}.optspace.euclidean.pcoa.axes",
    "data/simulation/{simulation}.{depth}.rpca.euclidean.pcoa.axes"
  conda:
    "envs/rpca.yml"
  wildcard_constraints:
    simulation="positive|negative|overlap"
  shell:
    """
    {input.pyscript} {input.tsv}
    """

rule transform_oclr:
  input:
    tsv="data/{dataset}/{control_depth}.raw.tsv.gz",
    pyscript="workflow/scripts/transform_oclr.py"
  output:
    tsv="data/{dataset}/{control_depth}.oclr.tsv.gz",
  conda:
    "envs/rpca.yml"
  group:
    "transform_oclr"
  resources:
    mem_mb=200
  shell:
    """
    {input.pyscript} {input.tsv}
    """

rule calc_dist_norare:
  input:
    tsv="data/{dataset}/{simulation_depth}.{process}.tsv.gz",
    rscript="workflow/scripts/calc_dist_norare.R"
  output:
    "data/{dataset}/{simulation_depth}.{process}.{distance}.dist.gz"
  wildcard_constraints:
    process="oclr|raw",
    distance="euclidean|bray"
  group:
    "calc_dist"
  resources:
    mem_mb=200
  shell:
    """
    {input.rscript} {input.tsv} {wildcards.distance}
    """

rule calc_pcoa_from_dist:
  input:
    dmatrix = "data/{dataset}/{approach}.{depth}.{process}.{distance}.dist.gz",
    rscript = "workflow/scripts/calc_pcoa_from_dist.R"
  output:
    "data/{dataset}/{approach}.{depth}.{process}.{distance}.pcoa.axes"
  wildcard_constraints:
    process="raw|oclr|rare|sub"
  group:
    "calc_pcoa_from_dist"
  resources:
    mem_mb=200
  shell:
    """
    {input.rscript} {input.dmatrix} {output}
    """

  
##******************************************************************************
##
## Carry out PERMANOVA and KNN tests on distance matrices. Not using the PCoA
## for KNN as was done in the original Martino et al paper for the Bray-Curtis
## distances
##
##******************************************************************************

rule test_permanova_simulation:
  input:
    dmatrix = "data/simulation/{control}.{depth}.{process}.{distance}.dist.gz",
    design = "data/simulation/simulation.design",
    rscript = "workflow/scripts/test_permanova.R"
  output:
    "data/simulation/{control,[A-Za-z0-9]+}.{depth,[0-9]+}.{process,[A-Za-z0-9]+}.{distance}.permanova.tsv"
  group:
    "test_permanova"
  resources:
    mem_mb=200
  shell:
    """
    {input.rscript} {input.dmatrix} {input.design} {output}
    """

rule test_permanova_size_simulation:
  input:
    dmatrix = "data/simulation/{control}.5000.size_{iteration}.{process}.{distance}.dist.gz",
    design = "data/simulation/{control}.5000.size_{iteration}.design",
    rscript = "workflow/scripts/test_permanova_size.R"
  output:
    "data/simulation/{control}.5000.size_{iteration}.{process}.{distance}.permanova.tsv"
  group:
    "test_permanova"
  resources:
    mem_mb=200
  shell:
    """
    {input.rscript} {input.dmatrix} {input.design} {output}
    """

rule test_knn_pds_simulation:
  input:
    dmatrix = "data/simulation/{approach}.{depth}.{process}.{distance}.dist.gz",
    design = "data/simulation/simulation.design",
    rscript = "workflow/scripts/test_train_knn.R"
  output:
    "data/simulation/{approach}.{depth}.{process}.{distance}.knn_pds.tsv"
  params:
    n_samples = 200
  group:
    "test_knn"
  resources:
    mem_mb=200
  shell:
    """
    R -e 'source("{input.rscript}");
          run_knn("{input.design}", "{input.dmatrix}", "{output}",
                  v_fraction = 0.8, t_fraction = 0.8,
                  k_grid = seq(3, {params.n_samples} * 0.8 * 0.8, length.out = 10))'
    """

rule test_knn_cm_simulation:
  input:
    dmatrix = "data/simulation/{approach}.{depth}.{process}.{distance}.dist.gz",
    design = "data/simulation/simulation.design",
    rscript = "workflow/scripts/test_train_knn.R"
  output:
    "data/simulation/{approach}.{depth}.{process}.{distance}.knn_cm.tsv"
  group:
    "test_knn"
  resources:
    mem_mb=200
  shell:
    """
    R -e 'source("{input.rscript}");
          run_knn("{input.design}", "{input.dmatrix}", "{output}",
                  v_fraction = 0.6, t_fraction = 0.6,
                  n_iloops = 100, n_oloops = 100,
                  k_grid = 13)'
    """

rule test_knn_cmgrid_simulation:
  input:
    dmatrix = "data/simulation/{approach}.{depth}.{process}.{distance}.dist.gz",
    design = "data/simulation/simulation.design",
    rscript = "workflow/scripts/test_train_knn.R"
  output:
    "data/simulation/{approach}.{depth}.{process}.{distance}.knn_cmgrid.tsv"
  params:
    n_samples = 200
  group:
    "test_knn"
  resources:
    mem_mb=200
  shell:
    """
    R -e 'source("{input.rscript}");
          run_knn("{input.design}", "{input.dmatrix}", "{output}",
                  v_fraction = 0.6, t_fraction = 0.6,
                  n_iloops = 100, n_oloops = 100,
                  k_grid = seq(3, {params.n_samples} * 0.6 * 0.6, length.out = 10))'
    """


##******************************************************************************
##
## Obtain datasets used in case studies and the Schloss Lab's colorectal
## cancer project. The latter is included because it does not have such an
## extreme effect size as was observed in the sponge and sleep apnea studies.
## Confirm that there is no confounding between treatment group and the number
## of sequences in each sample.
##
##******************************************************************************

rule decompress_biom_casestudy:
  input:
    biom_gz="deicode_benchmarking/case_studies/data/{dataset}/table.biom.gz",
    metadata_gz="deicode_benchmarking/case_studies/data/{dataset}/metadata.txt.gz"
  output:
    biom="data/{dataset}/table.biom",
    metadata="data/{dataset}/metadata.tsv"
  shell:
    """
    mkdir -p data/{wildcards.dataset} &&
      gunzip -c {input.biom_gz} > {output.biom} &&
      gunzip -c {input.metadata_gz} > {output.metadata}
    """

rule collect_data_metadata_cs:
  input:
    biom="data/{dataset}/table.biom",
    metadata="data/{dataset}/metadata.tsv",
    rscript="workflow/scripts/collect_data_metadata_cs.R"
  output:
    "data/{dataset}/data_treatment.tsv.gz",
  params:
    column=lambda wcs: treatment_groups[wcs.dataset]
  wildcard_constraints:
    process="sponges|sleep_apnea"
  shell:
    """
    {input.rscript} {input.biom} {input.metadata} {params.column}
    """

rule collect_data_metadata_crc:
  input:
    rscript="workflow/scripts/collect_data_metadata_crc.R"
  output:
    "data/crc/data_treatment.tsv.gz",
  shell:
    """
    mkdir -p data/crc  
    {input.rscript}
    """

##******************************************************************************
##
## Extract number of sequences per sample from each of the datasets and test
## whether sequencing depth is confounded with treatment group
##
##******************************************************************************

rule extract_depths_cs:
  input: 
    tsv="data/{dataset}/data_treatment.tsv.gz",
    rscript="workflow/scripts/extract_depths_cs.R"
  output:
    "data/{dataset}/data.depths.tsv"
  shell:
    """
    {input.rscript} {input.tsv} {output}
    """

rule test_depths_cs:
  input:
    tsv="data/{dataset}/data.depths.tsv",
    rscript="workflow/scripts/test_depths_cs.R"
  output:
    "data/{dataset}/data.dtest.tsv"
  shell:
    """
    {input.rscript} {input.tsv} {output}
    """

rule remove_rare_samples:
  input:
    tsv="data/{dataset}/data_treatment.tsv.gz",
    rscript="workflow/scripts/remove_rare_samples.R"
  output:
    "data/{dataset}/data.{depth}.raw_design.tsv.gz",
  shell:
    """
    {input.rscript} {input.tsv} {wildcards.depth}
    """

##******************************************************************************
##
## Generate subsamples by sample numbers. Need 10 replicates for each number
## of samples. Values of n samples selected to be similar to those found in 
## Martino et al. so that there are n samples in each of the treatment groups.
## Because the crc dataset has more samples per treatment group, I picked values
## that overlap and go beyond those used for the other datasets. The replicate
## number is used to set the seed in workflow/scripts/partition_by_nsamples.R
##
##******************************************************************************

rule partition_by_nsamples:
  input:
    tsv="data/{dataset}/data.{depth}.raw_design.tsv.gz",
    rscript="workflow/scripts/partition_by_nsamples.R"
  output:
    "data/{dataset}/data.{depth}.{nsamples_rep}.raw.tsv.gz",
    "data/{dataset}/data.{depth}.{nsamples_rep}.design",
  wildcard_constraints:
    nsamples_rep="!all|!size"
  group:
    "partition_by_nsamples"
  resources:
    mem_mb=200
  shell:
    """
    {input.rscript} {input.tsv} {wildcards.nsamples_rep}
    """

rule no_partition_by_samples:
  input:
    tsv="data/{dataset}/data.{depth}.raw_design.tsv.gz",
    rscript="workflow/scripts/no_partition_by_samples.R"
  output:
    "data/{dataset}/data.{depth}.all.raw.tsv.gz",
    "data/{dataset}/data.{depth}.all.design",
  shell:
    """
    {input.rscript} {input.tsv}
    """

rule partition_by_size_cs:
  input:
    tsv="data/{dataset}/data.10000.raw_design.tsv.gz",
    rscript="workflow/scripts/partition_by_size.R"
  output:
    "data/{dataset}/data.5000.size_{seed}.raw.tsv.gz",
    "data/{dataset}/data.5000.size_{seed}.design",
  shell:
    """
    {input.rscript} {input.tsv} {wildcards.seed}
    """


##******************************************************************************
##
## Calculate distances and PCoA
##
##    * Aitchison distances
##      see: rule transform_oclr - for CLR transformation
##      see: rule calc_dist_norare - for euclidean distance
##
##    * Raw distances - euclidean, braycurtis
##      see: rule calc_dist_norare
##
##    * PCoA for Euclidean and Bray-Curtis
##      see: rule calc_pcoa_from_dist:
##
##******************************************************************************

rule calc_dist_subsample:
  input:
    tsv="data/{dataset}/{data}.{depth}.{iteration}.raw.tsv.gz",
    rscript="workflow/scripts/calc_dist_subsample.R"
  output:
    "data/{dataset}/{data, [a-z]+}.{depth, [0-9]+}.{iteration}.sub.{distance}.dist.gz"
  group:
    "calc_dist"
  resources:
    mem_mb=200
  shell:
    """
    {input.rscript} {input.tsv} {wildcards.distance} {wildcards.depth}
    """

rule calc_dist_rarefaction:
