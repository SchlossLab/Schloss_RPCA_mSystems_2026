# Purpose:  Snakemake file for running data processing steps in reanalysis of
#           Martino et al. 2019 mSystems
#
#*******************************************************************************

depths = [500, 1000, 2000, 4000, 10000]
distances = ["bray", "euclidean"]
processes = ["optspace", "rpca"]
approaches = ["cm", "pds"]

rule targets:
  input:
    expand("data/simulation/overlap_{process}.{depth}.euclidean.pcoa.axes",
           process = processes, depth = depths),
    expand("data/simulation/overlap_raw.{depth}.{distance}.pcoa.axes",
           depth = depths, distance = distances),
    expand("data/simulation/overlap_{process}.{depth}.euclidean.permanova.tsv",
           process = processes, depth = depths),
    expand("data/simulation/overlap_raw.{depth}.{distance}.permanova.tsv",
           depth = depths, distance = distances),
    expand("data/simulation/overlap_{process}.{depth}.euclidean.knn_{approach}.tsv",
           process = processes, depth = depths, approach = approaches),
    expand("data/simulation/overlap_raw.{depth}.{distance}.knn_{approach}.tsv",
           process = processes, depth = depths, distance = distances, approach = approaches),
    expand("data/simulation/overlap_raw.{depth}.dtest.tsv",
           depth = depths),
    "figures/overlap_knn_analysis.png",
    "figures/overlap10000.pcoa.png"



rule extract_depths_overlap:
  input:
    csv="deicode_benchmarking/simulations/cluster_models/simulation_subsampled_noisy.csv.gz",
    rscript="workflow/scripts/extract_depths_overlap.R"
  output:
    "data/simulation/overlap_raw.{depth}.tsv.gz"
  shell:
    """
    mkdir -p data/simulation/
    {input.rscript} {input.csv} {wildcards.depth}
    """

rule calc_dist_vegan_worare:
  input:
    tsv="data/simulation/overlap_raw.{depth}.tsv.gz",
    rscript="workflow/scripts/calc_dist_vegan_worare.R"
  output:
    "data/simulation/overlap_raw.{depth}.{distance}.dist.gz"
  shell:
    """
    {input.rscript} {input.tsv} {wildcards.distance}
    """

rule calc_dist_rpca:
  input:
    csv="deicode_benchmarking/simulations/cluster_models/simulation_subsampled_noisy.csv.gz",
    rscript="workflow/scripts/calc_dist_rpca_overlap.py"
  output:
    "data/simulation/overlap_optspace.{depth}.euclidean.dist.gz",
    "data/simulation/overlap_rpca.{depth}.euclidean.dist.gz"
  conda:
    "envs/rpca.yml"
  shell:
    """
    {input.rscript} {wildcards.depth}
    """

rule create_design_simulation:
  input:
    csv="deicode_benchmarking/simulations/cluster_models/simulation_subsampled_noisy.csv.gz",
    rscript="workflow/scripts/create_design_overlap.R"
  output:
    "data/simulation/overlap.design.gz"
  shell:
    """
    {input.rscript} {input.csv} {output}
    """

rule calc_pcoa_coords:
  input:
    dmatrix = "data/simulation/overlap_{process}.{depth}.{distance}.dist.gz",
    rscript = "workflow/scripts/calc_pcoa_coords.R"
  output:
    "data/simulation/overlap_{process}.{depth}.{distance}.pcoa.axes"
  shell:
    """
    {input.rscript} {input.dmatrix} {output}
    """






rule test_depths:
  input:
    tsv="data/simulation/overlap_raw.{depth}.tsv.gz",
    design="data/simulation/overlap.design.gz",
    rscript="workflow/scripts/test_depths.R"
  output:
    "data/simulation/overlap_raw.{depth}.dtest.tsv"
  shell:
    """
    {input.rscript} {input.tsv} {input.design} {output}
    """

rule test_permanova:
  input:
    dmatrix = "data/simulation/overlap_{process}.{depth}.{distance}.dist.gz",
    design = "data/simulation/overlap.design.gz",
    rscript = "workflow/scripts/test_permanova.R"
  output:
    "data/simulation/overlap_{process}.{depth}.{distance}.permanova.tsv"
  shell:
    """
    {input.rscript} {input.dmatrix} {input.design} {output}
    """
    
rule test_knn_pds:
  input:
    dmatrix = "data/simulation/overlap_{process}.{depth}.{distance}.dist.gz",
    design = "data/simulation/overlap.design.gz",
    rscript = "workflow/scripts/test_train_knn.R"
  output:
    "data/simulation/overlap_{process}.{depth}.{distance}.knn_pds.tsv"
  shell:
    """
    R -e 'source("{input.rscript}"); run_knn("{input.design}", "{input.dmatrix}", "{output}")'
    """

rule test_knn_cm:
  input:
    dmatrix = "data/simulation/overlap_{process}.{depth}.{distance}.dist.gz",
    design = "data/simulation/overlap.design.gz",
    rscript = "workflow/scripts/test_train_knn.R"
  output:
    "data/simulation/overlap_{process}.{depth}.{distance}.knn_cm.tsv"
  shell:
    """
    R -e 'source("{input.rscript}"); run_knn("{input.design}", "{input.dmatrix}", "{output}",
                                              v_fraction = 0.6, t_fraction = 0.6,
                                              n_iloops = 100, n_oloops = 100,
                                              k_grid = 13)'
    """





rule plot_overlap_knn_analysis:
  input:
    rpca=expand("data/simulation/overlap_{process}.{depth}.euclidean.knn_{approach}.tsv",
           process = processes, depth = depths, approach = approaches),
    raw=expand("data/simulation/overlap_raw.{depth}.{distance}.knn_{approach}.tsv",
           process = processes, depth = depths, distance = distances, approach = approaches),
    rscript="workflow/scripts/plot_overlap_knn.R"
  output:
    "figures/overlap_knn_analysis.png"
  shell:
    """
    {input.rscript}
    """

rule plot_pcoa:
  input:
    bray_coords="data/simulation/overlap_raw.10000.bray.pcoa.axes",
    rpca_coords="data/simulation/overlap_rpca.10000.euclidean.pcoa.axes",
    design = "data/simulation/overlap.design.gz",
    rscript="workflow/scripts/plot_overlap10000_pcoa.R"
  output:
    "figures/overlap10000.pcoa.png"
  shell:
    """
    {input.rscript}
    """

