    "data/{dataset}/{data, [a-z]+}.{depth, [0-9]+}.{iteration}.rare.{distance}.dist.gz"
  group:
    "calc_dist"
  resources:
    mem_mb=200
  shell:
    """
    {input.rscript} {input.tsv} {wildcards.distance} {wildcards.depth}
    """

rule calc_dist_axes_gemelli:
  input:
    tsv="data/{dataset}/data.{depth}.{iteration}.raw.tsv.gz",
    bash="workflow/scripts/calc_dist_axes_gemelli.py"
  output:
    "data/{dataset}/data.{depth}.{iteration}.gemelli_{rank}.euclidean.dist.gz",
