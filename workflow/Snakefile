import re

n_iters = 10

treatment_groups = {
  'crc' : 'treatment',
  'sleep_apnea': 'exposure_type',
  'sponges': 'health_status'
}

simulations = {
  'positive': 'treatment',
  'negative': 'treatment',
  'overlap': 'treatment'
}

seq_depths = {
  "sponges": [1000, 13755], 
  "sleep_apnea": [1000, 11879],
  "crc": [1000, 10439],
  "positive": [1000, 2000, 4000, 10000],
  "negative": [1000, 2000, 4000, 10000],
  "overlap": [1000, 2000, 4000, 10000]
}

paritions_reps = {
  'crc' : {'all': 1, '35':n_iters, '83':n_iters, '130':n_iters, '178':n_iters, '226':n_iters},
  'sleep_apnea': {'all': 1, '35':n_iters, '48':n_iters, '61':n_iters, '74':n_iters, '87':n_iters},
  'sponges': {'all': 1, '35':n_iters, '45':n_iters, '55':n_iters, '61':n_iters, '78':n_iters},
  'positive': {100: n_iters},
  'negative': {100: n_iters},
  'overlap': {100: n_iters}
  }

processes_dists = {
  'raw':        {'euclidean', 'bray'},
  'rare':       {'euclidean', 'bray'},
  'sub':        {'euclidean', 'bray'},
  'oclr':       {'euclidean'},
  'gemelli_2':  {'euclidean'},
  'gemelli_3':  {'euclidean'},
  'gemelli_5':  {'euclidean'},
  'gemelli_9':  {'euclidean'},
  'gemelli_auto': {'euclidean'},
  'optspace':   {'euclidean'}
}

knn_analyses = ["knn_cmfixed.tsv", "knn_cmgrid.tsv", "knn_pdsgrid.tsv"]


pcoa_axes_files = []
permanova_treatment_files = []
knn_results_files = []

for ds,depths in seq_depths.items():
  for part,iters in paritions_reps[ds].items():
    for d in depths:
      for i in range(iters):
        for proc, dists in processes_dists.items():
          for dist in dists:
            pcoa_axes_files.append(f'data/{ds}/data.{d}.{part}_{i+1}.{proc}.{dist}.pcoa.axes')
            permanova_treatment_files.append(f'data/{ds}/data.{d}.{part}_{i+1}.{proc}.{dist}.permanova.tsv')
            if part != "all":
              for ka in knn_analyses:
                knn_results_files.append(f'data/{ds}/data.{d}.{part}_{i+1}.{proc}.{dist}.{ka}')

gemelli_auto_files = [s for s in pcoa_axes_files if 'auto' in s]

permanova_size_files = []
for ds in seq_depths.keys():
  for proc, dists in processes_dists.items():
    for dist in dists:
      for i in range(n_iters):
        pcoa_axes_files.append(f'data/{ds}/data.5000.size_{i+1}.{proc}.{dist}.pcoa.axes')
        permanova_size_files.append(f'data/{ds}/data.5000.size_{i+1}.{proc}.{dist}.permanova.tsv')


rule targets:
  input:
    pcoa_axes_files,
    "data/pooled_data/depth_confounding.tsv",
    "data/pooled_data/gemelli_auto_naxes.tsv",
    "data/pooled_data/permanova_treatment.tsv",
    "data/pooled_data/permanova_size.tsv",
    "data/pooled_data/knn_results.tsv.gz",
  # figures
    "figures/overlap10000.pcoa.png",
    "figures/control4000.pcoa.png",
    "figures/cs_seq_depth.png",
    #
    "figures/knn_overlap_comparison.png",
    "figures/knn_control_comparison.png",



##******************************************************************************
##
## Generate raw count tables from simulations and case studies.
##
## For the simulations, overlap files have some overlap between the
## treatment groups, the negative completely overlap, and the positive do not
## overlap at all. I have rerun the original code from deicode_benchmarking
## in my own script to (i) generate 10 replicates of each set of conditions, 
## (ii) insure that each sample only has the specified number of sequences
## rather than an average across samples, and (iii) to generate negative and
## positive control samples that have the same depths as the overlaps samples
##
## For the sponges and sleep_apnea, I am modifying the original code to (i) use
## more sensible sequencing depths and (ii) make it easier to have 10 replicates
## of each partition (original only had 9).
##
## I have added a CRC dataset that doesn't have as large a treatment effect as
## was seen in the simulations and sponges and sleep_apnea case studies. 
##
##******************************************************************************

rule decompress_biom_casestudy:
  input:
    biom_gz="deicode_benchmarking/case_studies/data/{case_study}/table.biom.gz",
    metadata_gz="deicode_benchmarking/case_studies/data/{case_study}/metadata.txt.gz"
  output:
    biom="data/{case_study}/table.biom",
    metadata="data/{case_study}/metadata.tsv"
  shell:
    """
    mkdir -p data/{wildcards.dataset} &&
      gunzip -c {input.biom_gz} > {output.biom} &&
      gunzip -c {input.metadata_gz} > {output.metadata}
    """

rule collect_data_metadata_cs:
  input:
    biom="data/{case_study}/table.biom",
    metadata="data/{case_study}/metadata.tsv",
    rscript="workflow/scripts/collect_data_metadata_cs.R"
  output:
    "data/{case_study}/data_treatment.tsv.gz",
  params:
    column=lambda wcs: treatment_groups[wcs.case_study]
  resources:
    mem_mb=12000
  wildcard_constraints:
    case_study="sponges|sleep_apnea"
  shell:
    """
    {input.rscript} {input.biom} {input.metadata} {params.column}
    """

rule collect_data_metadata_crc:
  input:
    rscript="workflow/scripts/collect_data_metadata_crc.R"
  output:
    "data/crc/data.{depth, \\d+}.raw.tsv.gz",
    "data/crc/data.{depth, \\d+}.design",
  shell:
    """
    mkdir -p data/crc  
    {input.rscript}
    """

rule collect_data_metadata_sim:
  input:
    deicode="deicode_benchmarking/simulations/scripts/simulations.py",
    pyscript="workflow/scripts/collect_data_metadata_sim.py"
  output:
    expand("data/{simulation}/data.{depth}.100_{rep}.raw.tsv.gz",
          simulation = simulations.keys(), allow_missing = True),
    expand("data/{simulation}/data.{depth}.100_{rep}.design",
          simulation = simulations.keys(), allow_missing = True)
  conda:
    "envs/rpca.yml"
  shell:
    """
    mkdir -p data/positive data/negative data/overlap
    PYTHONPATH='.' {input.pyscript} {wildcards.depth} {wildcards.rep}
    """

rule remove_rare_samples:
  input:
    tsv="data/{case_study}/data_treatment.tsv.gz",
    rscript = "workflow/scripts/remove_rare_samples.R"
  output:
    counts = "data/{case_study}/data.{depth}.all_1.raw.tsv.gz",
    design = "data/{case_study}/data.{depth}.all_1.design",
  wildcard_constraints:
      case_study="sponges|sleep_apnea|crc"
  shell:
    """
    {input.rscript} {input.tsv} {wildcards.depth}
    """

##******************************************************************************
##
## Generate subsamples by sample numbers. Need 10 replicates for each number
## of samples. Values of n samples selected to be similar to those found in 
## Martino et al. so that there are n samples in each of the treatment groups.
## Because the crc dataset has more samples per treatment group, I picked values
## that overlap and go beyond those used for the other datasets. The replicate
## number is used to set the seed in workflow/scripts/partition_by_nsamples.R
##
##******************************************************************************

rule partition_by_nsamples:
  input:
    all =     "data/{case_study}/data.{depth}.all_1.raw.tsv.gz",
    design =  "data/{case_study}/data.{depth}.all_1.design",
    rscript = "workflow/scripts/partition_by_nsamples.R"
  output:
    "data/{case_study}/data.{depth, \\d+}.{partition, \\d+}_{rep, \\d+}.raw.tsv.gz",
    "data/{case_study}/data.{depth, \\d+}.{partition, \\d+}_{rep, \\d+}.design",
  group:
    "partition_by_nsamples"
  resources:
    mem_mb=200
  wildcard_constraints:
      case_study="sponges|sleep_apnea|crc"
  shell:
    """
    {input.rscript} {input.all} {input.design} {wildcards.partition} {wildcards.rep}
    """

rule partition_by_sizes_cs:
  input:
    all =     "data/{case_study}/data.10000.all_1.raw.tsv.gz",
    design =  "data/{case_study}/data.10000.all_1.design",
    rscript = "workflow/scripts/partition_by_size.R"
  output:
    "data/{case_study}/data.5000.size_{rep, \\d+}.raw.tsv.gz",
    "data/{case_study}/data.5000.size_{rep, \\d+}.design",
  wildcard_constraints:
    case_study = "crc|sleep_apnea|sponges"
  group:
    "partition_by_size"
  resources:
    mem_mb=500
  shell:
    """
    {input.rscript} {input.all} {input.design} {wildcards.rep}
    """

rule partition_by_sizes_sim:
  input:
    all =     "data/{simulation}/data.10000.100_{rep}.raw.tsv.gz",
    design =  "data/{simulation}/data.10000.100_{rep}.design",
    rscript = "workflow/scripts/partition_by_size.R"
  output:
    "data/{simulation}/data.5000.size_{rep, \\d+}.raw.tsv.gz",
    "data/{simulation}/data.5000.size_{rep, \\d+}.design",
  wildcard_constraints:
    simulation = "positive|negative|overlap"
  group:
    "partition_by_size"
  resources:
    mem_mb=500
  shell:
    """
    {input.rscript} {input.all} {input.design} {wildcards.rep}
    """


# ******************************************************************************
#
# Calculate distances and ordinations. Am using the ipynb code for the RPCA
# calculations because need the OptSpace data, which doesn't appear available
# in gemelli
#
# ******************************************************************************

rule transform_oclr:
  input:
    tsv="data/{dataset}/data.{other_stuff}.raw.tsv.gz",
    pyscript="workflow/scripts/transform_oclr.py"
  output:
    tsv="data/{dataset}/data.{other_stuff}.oclr.tsv.gz",
  conda:
    "envs/rpca.yml"
  group:
    "transform_oclr"
  resources:
    mem_mb=200
  shell:
    """
    {input.pyscript} {input.tsv}
    """

rule calc_dist_norare:
  input:
    tsv="data/{dataset}/data.{other_stuff}.{process}.tsv.gz",
    rscript="workflow/scripts/calc_dist_norare.R"
  output:
    "data/{dataset}/data.{other_stuff}.{process}.{distance}.dist.gz"
  wildcard_constraints:
    process="oclr|raw",
    distance="euclidean|bray"
  group:
    "calc_dist"
  resources:
    mem_mb=200
  shell:
    """
    {input.rscript} {input.tsv} {wildcards.distance}
    """

rule calc_dist_subsample:
  input:
    tsv="data/{dataset}/data.{depth}.{other_stuff}.raw.tsv.gz",
    rscript="workflow/scripts/calc_dist_subsample.R"
  output:
    "data/{dataset}/{data, [a-z]+}.{depth, [0-9]+}.{other_stuff}.sub.{distance}.dist.gz"
  group:
    "calc_dist"
  resources:
    mem_mb=200
  shell:
    """
    {input.rscript} {input.tsv} {wildcards.distance} {wildcards.depth}
    """

rule calc_dist_rarefaction:
  input:
    tsv="data/{dataset}/data.{depth}.{other_stuff}.raw.tsv.gz",
    rscript="workflow/scripts/calc_dist_rarefaction.R"
  output:
    "data/{dataset}/{data, [a-z]+}.{depth, [0-9]+}.{other_stuff}.rare.{distance}.dist.gz"
  group:
    "calc_dist"
  resources:
    mem_mb=200
  shell:
    """
    {input.rscript} {input.tsv} {wildcards.distance} {wildcards.depth}
    """

rule calc_dist_axes_gemelli:
  input:
    tsv="data/{dataset}/data.{other_stuff}.raw.tsv.gz",
    bash="workflow/scripts/calc_dist_axes_gemelli.py"
  output:
    "data/{dataset}/data.{other_stuff}.gemelli_{rank}.euclidean.dist.gz",
    "data/{dataset}/data.{other_stuff}.gemelli_{rank}.euclidean.pcoa.axes"
  conda:
    "envs/rpca.yml"
  group:
    "calc_dist_axes_gemelli"
  resources:
    mem_mb=200
  shell:
    """
    {input.bash} {input.tsv} {wildcards.rank}
    """

rule calc_dist_axes_optspace:
  input:
    tsv="data/{dataset}/data.{other_stuff}.raw.tsv.gz",
    pyscript="workflow/scripts/calc_dist_axes_optspace.py"
  output:
    "data/{dataset}/data.{other_stuff}.optspace.euclidean.dist.gz",
    "data/{dataset}/data.{other_stuff}.optspace.euclidean.pcoa.axes",
  conda:
    "envs/rpca.yml"
  shell:
    """
    {input.pyscript} {input.tsv}
    """


##******************************************************************************
##
## Carry out PERMANOVA and KNN tests on distance matrices. Not using the PCoA
## for KNN as was done in the original Martino et al paper for the Bray-Curtis
## distances
##
##******************************************************************************

rule calc_pcoa_from_dist:
  input:
    dmatrix = "data/{dataset}/data.{depth}.{partition}_{iter}.{process}.{dist}.dist.gz",
    rscript = "workflow/scripts/calc_pcoa_from_dist.R"
  output:
    "data/{dataset}/data.{depth}.{partition}_{iter}.{process}.{dist}.pcoa.axes",
  wildcard_constraints:
    process="raw|oclr|rare|sub"
  group:
    "calc_pcoa_from_dist"
  resources:
    mem_mb=200
  shell:
    """
    {input.rscript} {input.dmatrix} {output}
    """


rule test_permanova_treatment:
  input:
    dmatrix = "data/{dataset}/data.{depth}.{partition}_{iter}.{process}.{dist}.dist.gz",
    design = "data/{dataset}/data.{depth}.{partition}_{iter}.design",
    rscript = "workflow/scripts/test_permanova_treatment.R"
  output:
    "data/{dataset}/data.{depth}.{partition}_{iter}.{process}.{dist}.permanova.tsv",
  wildcard_constraints:
    depth = "!5000"
  group:
    "test_permanova"
  resources:
    mem_mb=200
  shell:
    """
    {input.rscript} {input.dmatrix} {input.design} {output}
    """

rule test_permanova_size:
  input:
    dmatrix = "data/{dataset}/data.5000.size_{iter}.{process}.{dist}.dist.gz",
    design = "data/{dataset}/data.5000.size_{iter}.design",
    rscript = "workflow/scripts/test_permanova_size.R"
  output:
    "data/{dataset}/data.5000.size_{iter}.{process}.{dist}.permanova.tsv",
  group:
    "test_permanova"
  resources:
    mem_mb=200
  shell:
    """
    {input.rscript} {input.dmatrix} {input.design} {output}
    """


rule test_knn_fixed:
  input:
    dmatrix = "data/{dataset}/data.{depth}.{size}_{iteration}.{process}.{distance}.dist.gz",
    design = "data/{dataset}/data.{depth}.{size}_{iteration}.design",
    rscript = "workflow/scripts/test_train_knn.R"
  output:
    "data/{dataset}/data.{depth}.{size}_{iteration}.{process}.{distance}.knn_cmfixed.tsv"
  group:
    "test_knn"
  resources:
    mem_mb=400
  shell:
    """
    R -e 'source("{input.rscript}");
          run_knn("{input.design}", "{input.dmatrix}", "{output}",
                  v_fraction = 0.6, t_fraction = 0.6,
                  n_iloops = 100, n_oloops = 100,
                  k_grid = round(2 * {wildcards.size} * 13 / 200))'
    """

rule test_knn_80_20:
  input:
    dmatrix = "data/{dataset}/data.{depth}.{size}_{iteration}.{process}.{distance}.dist.gz",
    design = "data/{dataset}/data.{depth}.{size}_{iteration}.design",
    rscript = "workflow/scripts/test_train_knn.R"
  group:
    "test_knn"
  resources:
    mem_mb=400
  output:
    "data/{dataset}/data.{depth}.{size}_{iteration}.{process}.{distance}.knn_pdsgrid.tsv"
  shell:
    """
    R -e 'source("{input.rscript}");
          run_knn("{input.design}", "{input.dmatrix}", "{output}",
                  v_fraction = 0.8, t_fraction = 0.8,
                  k_grid = seq(3, 2 * {wildcards.size} * 0.8 * 0.8, length.out = 10))'
    """

rule test_knn_60_40:
  input:
    dmatrix = "data/{dataset}/data.{depth}.{size}_{iteration}.{process}.{distance}.dist.gz",
    design = "data/{dataset}/data.{depth}.{size}_{iteration}.design",
    rscript = "workflow/scripts/test_train_knn.R"
  output:
    "data/{dataset}/data.{depth}.{size}_{iteration}.{process}.{distance}.knn_cmgrid.tsv"
  group:
    "test_knn"
  resources:
    mem_mb=400
  shell:
    """
    R -e 'source("{input.rscript}");
          run_knn("{input.design}", "{input.dmatrix}", "{output}",
                  v_fraction = 0.6, t_fraction = 0.6,
                  n_iloops = 100, n_oloops = 100,
                  k_grid = seq(3, 2 * {wildcards.size} * 0.6 * 0.6, length.out = 10))'
    """


