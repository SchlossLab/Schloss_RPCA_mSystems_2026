  input:
    "submission/manuscript.qmd",
    "submission/references.bib",
    "submission/asm.csl"
  output:
    expand("submission/manuscript.{format}",
          format = ["pdf", "md", "tex", "docx"])
  shell:
    """
    quarto render submission/manuscript.qmd
    """