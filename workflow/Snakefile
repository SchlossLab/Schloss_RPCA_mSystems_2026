rule test_knn_pds_cs:
  input:
    dmatrix = "data/{dataset}/data.{depth}.{size}_{iteration}.{process}.{distance}.dist.gz",
    design = "data/{dataset}/data.{depth}.{size}_{iteration}.design",
    rscript = "workflow/scripts/test_train_knn.R"
  group:
    "test_knn"
  resources:
    mem_mb=200
  output:
    "data/{dataset}/data.{depth}.{size}_{iteration}.{process}.{distance}.knn_pds.tsv"
  shell:
