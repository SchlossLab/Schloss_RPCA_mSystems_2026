depths = [500, 1000, 2000, 4000, 10000]
distances = ["bray", "euclidean"]
processes = ["optspace", "rpca"]
approaches = ["cm", "pds", "cmgrid"]
controls = ["positive", "negative"]

treatment_groups = {"sponges": "health_status",
                    "sleep_apnea": "exposure_type"}
datasets = ["sponges", "sleep_apnea", "crc"]

rule targets:
  input:
    "figures/cs_seq_depth.png",
    "figures/overlap_knn_analysis.png",
    "figures/overlap10000.pcoa.png",
    "figures/control4000.pcoa.png",
    expand("data/simulation/overlap_oclr.{depth}.tsv.gz",
           depth = depths),
    expand("data/simulation/overlap_oclr.{depth}.euclidean.pcoa.axes",
           depth = depths, distance = distances),
    expand("data/simulation/overlap_{process}.{depth}.euclidean.pcoa.axes",
           process = processes, depth = depths),
    expand("data/simulation/overlap_{process}.{depth}.euclidean.permanova.tsv",
           process = processes, depth = depths),
    expand("data/simulation/overlap_raw.{depth}.{distance}.permanova.tsv",
           depth = depths, distance = distances),
    expand("data/simulation/overlap_{process}.{depth}.euclidean.knn_{approach}.tsv",
           process = processes, depth = depths, approach = approaches),
    expand("data/simulation/overlap_raw.{depth}.{distance}.knn_{approach}.tsv",
           process = processes, depth = depths, distance = distances,
           approach = approaches),
    expand("data/simulation/overlap_raw.{depth}.dtest.tsv",
           depth = depths),
    expand("data/simulation/{control}_oclr.4000.tsv.gz",
           control = controls),
    expand("data/simulation/{control}_oclr.4000.euclidean.pcoa.axes",
           control = controls, process = processes),
    expand("data/simulation/{control}_raw.4000.{distance}.pcoa.axes",
           control = controls, distance = distances),
    expand("data/simulation/{control}_{process}.4000.euclidean.permanova.tsv",
           control = controls, process = processes),
    expand("data/simulation/{control}_raw.4000.{distance}.permanova.tsv",
           control = controls, distance = distances),
    expand("data/simulation/{control}_{process}.4000.euclidean.knn_{approach}.tsv",
           control = controls, process = processes, approach = approaches),
    expand("data/simulation/{control}_raw.4000.{distance}.knn_{approach}.tsv",
           control = controls, process = processes, distance = distances,
           approach = approaches),
    expand("data/simulation/{control}_raw.4000.dtest.tsv",
           control = controls),





rule extract_counts_overlap:
  input:
    csv="deicode_benchmarking/simulations/cluster_models/simulation_subsampled_noisy.csv.gz",
    rscript="workflow/scripts/extract_counts_overlap.R"
  output:
    "data/simulation/overlap_raw.{depth}.tsv.gz"
  shell:
    """
    mkdir -p data/simulation/
    {input.rscript} {input.csv} {wildcards.depth}
    """

rule extract_counts_control:
  input:
    pyscript="workflow/scripts/extract_counts_control.py",
    deicode="deicode_benchmarking/simulations/scripts/simulations.py"
  output:
    expand("data/simulation/{control}_raw.4000.tsv.gz",
           control = ["positive", "negative"])
  conda:
    "envs/rpca.yml"
  shell:
    """
    mkdir -p data/simulation/
    PYTHONPATH='.' {input.pyscript}
    """

rule create_design_simulation:
  input:
    csv="deicode_benchmarking/simulations/cluster_models/simulation_subsampled_noisy.csv.gz",
    rscript="workflow/scripts/create_design_overlap.R"
  output:
    "data/simulation/overlap.design.gz"
  shell:
    """
    {input.rscript} {input.csv} {output}
    """


rule decompress_biom_casestudy:
  input:
    "{path_name}.biom.gz"
  output:
    "{path_name}.biom"
  shell:
    """
    gunzip -k {input}
    """
    
rule collect_data_metadata_cs:
  input:
    biom="deicode_benchmarking/case_studies/data/{dataset}/table.biom",
    metadata="deicode_benchmarking/case_studies/data/{dataset}/metadata.txt.gz",
    rscript="workflow/scripts/collect_data_metadata_cs.R"
  output:
    "data/{dataset}/data_treatment.tsv.gz",
  params:
    column=lambda wcs: treatment_groups[wcs.dataset]
  shell:
    """
    mkdir -p data/{wildcards.dataset}
    {input.rscript} {input.biom} {input.metadata} {params.column}
    """
  
rule collect_data_metadata_crc:
  input:
    rscript="workflow/scripts/collect_data_metadata_crc.R"
  output:
    "data/crc/data_treatment.tsv.gz",
  shell:
    """
    mkdir -p data/crc  
    {input.rscript}
    """


rule extract_depths_cs:
  input: 
    tsv="data/{dataset}/data_treatment.tsv.gz",
    rscript="workflow/scripts/extract_depths_cs.R"
  output:
    "data/{dataset}/data.depths.tsv.gz"
  shell:
    """
    {input.rscript} {input.tsv} {output}
    """
  

rule calc_oclr:
  input:
    tsv="data/simulation/{control}_raw.{depth}.tsv.gz",
    pyscript="workflow/scripts/calc_oclr.py"
  output:
    tsv="data/simulation/{control}_oclr.{depth}.tsv.gz",
  conda:
    "envs/rpca.yml"
  shell:
    """
    {input.pyscript} {input.tsv}
    """

rule calc_dist_axes_rpca_overlap:
  input:
    csv="deicode_benchmarking/simulations/cluster_models/simulation_subsampled_noisy.csv.gz",
    pyscript="workflow/scripts/calc_dist_rpca_overlap.py"
  output:
    "data/simulation/overlap_optspace.{depth}.euclidean.dist.gz",
    "data/simulation/overlap_rpca.{depth}.euclidean.dist.gz",
    "data/simulation/overlap_optspace.{depth}.euclidean.pcoa.axes",
    "data/simulation/overlap_rpca.{depth}.euclidean.pcoa.axes"
  conda:
    "envs/rpca.yml"
  shell:
    """
    {input.pyscript} {wildcards.depth}
    """

rule calc_dist_axes_rpca_control:
  input:
    tsv="data/simulation/{control}_raw.4000.tsv.gz",
    pyscript="workflow/scripts/calc_dist_rpca_control.py"
  output:
    "data/simulation/{control}_optspace.4000.euclidean.dist.gz",
    "data/simulation/{control}_rpca.4000.euclidean.dist.gz",
    "data/simulation/{control}_optspace.4000.euclidean.pcoa.axes",
    "data/simulation/{control}_rpca.4000.euclidean.pcoa.axes"
  wildcard_constraints:
    control="positive|negative"
  conda:
    "envs/rpca.yml"
  shell:
    """
    {input.pyscript} {input.tsv}
    """


rule calc_dist_vegan_worare:
  input:
    tsv="data/simulation/{simulation}_{process}.{depth}.tsv.gz",
    rscript="workflow/scripts/calc_dist_vegan_worare.R"
  output:
    "data/simulation/{simulation}_{process}.{depth}.{distance}.dist.gz"
  wildcard_constraints:
    process="oclr|raw"
  shell:
    """
    {input.rscript} {input.tsv} {wildcards.distance}
    """


rule calc_pcoa_coords:
  input:
    dmatrix = "data/simulation/{approach}_{process}.{depth}.{distance}.dist.gz",
    rscript = "workflow/scripts/calc_pcoa_coords.R"
  output:
    "data/simulation/{approach}_{process}.{depth}.{distance}.pcoa.axes"
  wildcard_constraints:
    process="raw|oclr"
  shell:
    """
    {input.rscript} {input.dmatrix} {output}
    """

  


rule test_depths_cs:
  input:
    tsv="data/{dataset}/data.depths.tsv.gz",
    rscript="workflow/scripts/test_depths_cs.R"
  output:
    "data/{dataset}/data.dtest.tsv"
  shell:
    """
    {input.rscript} {input.tsv} {output}
    """


rule test_depths_control:
  input:
    tsv="data/simulation/{approach}_raw.{depth}.tsv.gz",
    design="data/simulation/overlap.design.gz",
    rscript="workflow/scripts/test_depths_control.R"
  output:
    "data/simulation/{approach}_raw.{depth}.dtest.tsv"
  shell:
    """
    {input.rscript} {input.tsv} {input.design} {output}
    """

rule test_permanova:
  input:
    dmatrix = "data/simulation/{approach}_{process}.{depth}.{distance}.dist.gz",
    design = "data/simulation/overlap.design.gz",
    rscript = "workflow/scripts/test_permanova.R"
  output:
    "data/simulation/{approach}_{process}.{depth}.{distance}.permanova.tsv"
  shell:
    """
    {input.rscript} {input.dmatrix} {input.design} {output}
    """
    
rule test_knn_pds:
  input:
    dmatrix = "data/simulation/{approach}_{process}.{depth}.{distance}.dist.gz",
    design = "data/simulation/overlap.design.gz",
    rscript = "workflow/scripts/test_train_knn.R"
  output:
    "data/simulation/{approach}_{process}.{depth}.{distance}.knn_pds.tsv"
  shell:
    """
    R -e 'source("{input.rscript}"); run_knn("{input.design}", "{input.dmatrix}", "{output}")'
    """

rule test_knn_cm:
  input:
    dmatrix = "data/simulation/{approach}_{process}.{depth}.{distance}.dist.gz",
    design = "data/simulation/overlap.design.gz",
    rscript = "workflow/scripts/test_train_knn.R"
  output:
    "data/simulation/{approach}_{process}.{depth}.{distance}.knn_cm.tsv"
  shell:
    """
    R -e 'source("{input.rscript}"); run_knn("{input.design}", "{input.dmatrix}", "{output}",
                                              v_fraction = 0.6, t_fraction = 0.6,
                                              n_iloops = 100, n_oloops = 100,
                                              k_grid = 13)'
    """

rule test_knn_cmgrid:
  input:
    dmatrix = "data/simulation/{approach}_{process}.{depth}.{distance}.dist.gz",
    design = "data/simulation/overlap.design.gz",
    rscript = "workflow/scripts/test_train_knn.R"
  output:
    "data/simulation/{approach}_{process}.{depth}.{distance}.knn_cmgrid.tsv"
  shell:
    """
    R -e 'source("{input.rscript}"); run_knn("{input.design}", "{input.dmatrix}", "{output}",
                                              v_fraction = 0.6, t_fraction = 0.6,
                                              n_iloops = 100, n_oloops = 100)'
    """




# Plotting results

rule plot_overlap_knn_analysis:
  input:
    rpca=expand("data/simulation/overlap_{process}.{depth}.euclidean.knn_{approach}.tsv",
           process = processes, depth = depths, approach = approaches),
    raw=expand("data/simulation/overlap_raw.{depth}.{distance}.knn_{approach}.tsv",
           process = processes, depth = depths, distance = distances, approach = approaches),
    rscript="workflow/scripts/plot_overlap_knn.R"
  output:
    "figures/overlap_knn_analysis.png"
  shell:
    """
    {input.rscript}
    """

rule plot_pcoa:
  input:
    bray_coords="data/simulation/overlap_raw.10000.bray.pcoa.axes",
    rpca_coords="data/simulation/overlap_rpca.10000.euclidean.pcoa.axes",
    design = "data/simulation/overlap.design.gz",
    rscript="workflow/scripts/plot_overlap10000_pcoa.R"
  output:
    "figures/overlap10000.pcoa.png"
  shell:
    """
    {input.rscript}
    """
    
rule plot_pcoa_control:
  input:
    bray_coords=expand("data/simulation/{control}_raw.4000.bray.pcoa.axes",
                       control = ["positive", "negative"]),
    rpca_coords=expand("data/simulation/{control}_rpca.4000.euclidean.pcoa.axes",
                       control = ["positive", "negative"]),
