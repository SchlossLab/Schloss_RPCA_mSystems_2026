##******************************************************************************
##
## Pool analyses
##
##******************************************************************************

rule pool_depth_confounding:
  input:
    tsv = expand("data/{dataset}/data.depth_confounding.tsv",
           dataset = list(treatment_groups.keys())),
    rscript = "workflow/scripts/pool_depth_confounding.R"
  output:
