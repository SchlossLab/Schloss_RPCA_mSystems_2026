  output:
    "figures/overlap10000.pcoa.png"
  shell:
    """
    {input.rscript}
    """
    
rule plot_pcoa_control:
  input:
    bray_coords=expand("data/simulation/{control}.4000.raw.bray.pcoa.axes",
                       control = ["positive", "negative"]),
    rpca_coords=expand("data/simulation/{control}.4000.rpca.euclidean.pcoa.axes",
                       control = ["positive", "negative"]),
    design = "data/simulation/simulation.design",
    rscript="workflow/scripts/plot_control4000_pcoa.R"
  output:
    "figures/control4000.pcoa.png"
  shell:
    """
    {input.rscript}
    """

rule plot_knn_overlap:
  input:
    knn="data/process/simulation.knn.tsv",
    rscript="workflow/scripts/plot_knn_overlap.R"
