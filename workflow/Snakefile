rule plot_pcoa_simulation:
  input:
    axes=expand(
      "data/{simulation}/data.{depth}.100_{seed}.{process_dist}.pcoa.axes",
      simulation = ["negative", "overlap", "positive",
                    "negative_pds", "overlap_pds", "positive_pds"],
      process_dist = ["raw.euclidean", "raw.bray", "oclr.euclidean",
                      "optspace.euclidean", "gemelli_2.euclidean",
                      "bray_pcoa.euclidean"],
      allow_missing = True),
    design = expand(
      "data/{simulation}/data.{depth}.100_{seed}.design",
      simulation = ["negative", "overlap", "positive",
                    "negative_pds", "overlap_pds", "positive_pds"],
      allow_missing = True
    ),
    rscript="workflow/scripts/plot_pcoa_simulation.R"
  output:
    "figures/pcoa/{depth}_{seed}.tiff"
  shell:
    """
    {input.rscript} {wildcards.depth} {wildcards.seed}
    """

