rule pool_dtest_simulation:
  input:
    tsv = expand("data/simulation/{simulation_depth}.raw.dtest.tsv",
           simulation_depth = simulations_depths),
    rscript = "workflow/scripts/pool_dtest_simulation.R"
  output:
    "data/process/simulation.dtest.tsv"
  shell:
    """
    {input.rscript}
    """

rule pool_dtest_cs:
  input:
    tsv = expand("data/{dataset}/data.dtest.tsv",
           dataset = list(two_depths.keys())),
    rscript = "workflow/scripts/pool_dtest_cs.R"
  output:
    "data/process/case_studies.dtest.tsv"
  shell:
    """
    {input.rscript} {input.tsv}
    """

rule pool_permanova_simulation:
  input:
    depths = expand("data/simulation/{simulation_depth}.{process_dist}.permanova.tsv",
           simulation_depth = simulations_depths,
           process_dist = control_processes_dists),
    sizes = expand("data/simulation/{control}.5000.size_{iteration}.{process_dist}.permanova.tsv",
            control = simulations.keys(),
            iteration = range(1,11),
            process_dist = control_processes_dists + control_processs_dists_extra),
    rscript = "workflow/scripts/pool_permanova_simulation.R"
  output:
    "data/process/simulation.permanova.tsv"
  shell:
    """
    {input.rscript}
    """

rule pool_permanova_cs:
  input:
    all_samples =  expand("{sample_depth_nsample_rep}.{process_dist}.permanova.tsv",
            sample_depth_nsample_rep = samples_depths_all,
            process_dist = cs_processes_dist),
    samples_depths =  expand("{sample_depth_nsample_rep}.{process_dist}.permanova.tsv",
            sample_depth_nsample_rep = samples_depths_nsamples_reps,
            process_dist = cs_processes_dist),
    size_samples = expand("data/{dataset}/data.5000.size_{iteration}.{process_dist}.permanova.tsv",
            dataset = two_depths.keys(),
            iteration = range(1,11),
            process_dist = cs_processes_dist),
    rscript = "workflow/scripts/pool_permanova_cs.R"
  output:
    "data/process/case_studies.permanova.tsv"
  shell:
    """
    {input.rscript}
    """

rule pool_knn_simulation:
